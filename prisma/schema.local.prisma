generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite untuk development offline — TANPA internet, tanpa setup apa pun.
  // Dipilih otomatis oleh scripts/select-schema.mjs saat DATABASE_URL
  // diawali "file:". Untuk produksi (Vercel + Supabase) pakai prisma/schema.prisma.
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  phone          String
  nim            String?  @unique
  role           String   @default("USER") // USER | DRIVER | ADMIN
  avatarUrl      String?
  // Mode pembuka aplikasi: PENUMPANG (beranda) | DRIVER (dashboard).
  // Satu akun bisa menjalankan keduanya — mode hanya menentukan halaman awal.
  appMode        String   @default("PENUMPANG")

  // Driver-specific fields
  vehiclePlate   String?
  vehicleType    String?
  ktmUrl         String?
  verifyStatus   String?  // PENDING | VERIFIED | REJECTED (driver only)
  isOnline       Boolean  @default(false)
  // Pemblokiran oleh admin (pelanggaran aturan): login tetap boleh, tapi
  // driver tidak bisa online / menerima pesanan baru.
  banned         Boolean  @default(false)
  banReason      String?
  bannedAt       DateTime?
  rating         Float    @default(0)
  ratingCount    Int      @default(0)
  totalTrips     Int      @default(0)
  totalEarnings  Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]  @relation("UserOrders")
  drives         Order[]  @relation("DriverOrders")
  addresses      SavedAddress[]
  pushSubs       PushSubscription[]
  reportsMade    Report[] @relation("ReporterReports")
  reportsAgainst Report[] @relation("TargetReports")
}

model Location {
  id         String   @id @default(cuid())
  name       String
  category   String   // KAMPUS | KOS | PUBLIK
  // Kolom usang (legacy): tarif zona lama — TIDAK dipakai lagi.
  // Tarif kini dihitung dari jarak tempuh (lihat src/lib/fare.ts).
  fare       Int      @default(6000)
  isPopular  Boolean  @default(false)
  lat        Float?   // koordinat peta (approx, untuk Leaflet/OSM)
  lng        Float?

  pickups    Order[]  @relation("PickupOrders")
  drops      Order[]  @relation("DestOrders")
  addressOf  SavedAddress[]
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  detail     String?
  createdAt  DateTime @default(now())
}

model Order {
  id             String    @id @default(cuid())
  code           String    @unique // KMH-XXXX
  userId         String
  user           User      @relation("UserOrders", fields: [userId], references: [id])
  driverId       String?
  driver         User?     @relation("DriverOrders", fields: [driverId], references: [id])

  type           String    // OJEK | BARANG | MAKANAN
  pickupLocationId String
  pickupLocation Location  @relation("PickupOrders", fields: [pickupLocationId], references: [id])
  destLocationId String
  destLocation   Location  @relation("DestOrders", fields: [destLocationId], references: [id])
  pickupDetail   String?
  destDetail     String?
  itemNote       String?   // deskripsi barang / makanan
  passengerNote  String?

  // Koordinat peta (bisa digeser user saat memesan; null = pakai koordinat lokasi)
  pickupLat      Float?
  pickupLng      Float?
  destLat        Float?
  destLng        Float?
  // Posisi driver terakhir saat pesanan aktif (dikirim dashboard driver)
  driverLat      Float?
  driverLng      Float?
  driverPosAt    DateTime?

  // ==== Tarif resmi (jarak tempuh + surcharge, sejak 15 Nov 2026) ====
  // Jarak rute yang dipakai menghitung tarif (meter; null = tak ada
  // koordinat → tarif minimum 100 m–2,2 km).
  distanceMeters Int?
  rain           Boolean @default(false) // pelanggan tetap minta jalan saat hujan
  // Aturan Food Delivery (hanya MAKANAN):
  portions       Int?    // jumlah porsi/bungkus (1–2 normal)
  places         Int?    // jumlah tempat pembelian
  waitingMinutes Int?    // lama driver menunggu (diisi saat complete)
  // Rincian tarif resmi saat pesanan dibuat (JSON FareBreakdown) —
  // ditampilkan apa adanya di detail pesanan.
  fareBreakdown  Json?
  // Total tarif akhir (Rp) — diperbarui bila waktu tunggu ditambahkan.
  fare           Int     // total tarif (Rp)
  paymentMethod  String  @default("TUNAI")
  status         String    @default("MENCARI") // MENCARI | DIKONFIRMASI | BERJALAN | SELESAI | DIBATALKAN
  rating         Int?
  review         String?

  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  reports        Report[] @relation("OrderReports")
}

// Laporan pelanggaran dari pengguna — dua arah: penumpang → driver atau
// driver → penumpang, terkait satu pesanan. Satu laporan per pesanan per
// pelapor (unique); admin menindak lewat panel Laporan (blokir dsb.).
model Report {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation("OrderReports", fields: [orderId], references: [id])
  reporterId String
  reporter   User      @relation("ReporterReports", fields: [reporterId], references: [id])
  targetId   String
  target     User      @relation("TargetReports", fields: [targetId], references: [id])
  reason     String    // kategori pelanggaran (pilihan tetap dari UI)
  note       String?   // uraian tambahan pelapor (opsional)
  status     String    @default("OPEN") // OPEN | RESOLVED
  resolution String?   // catatan admin saat menutup laporan
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([orderId, reporterId])
  @@index([status])
}

// Pengaturan aplikasi yang dapat diubah admin (mis. tarif dasar).
model Setting {
  key   String @id
  value String
}

// Langganan Web Push per perangkat driver — untuk notifikasi pesanan baru
// walau tab/aplikasi KOMAH sedang ditutup (service worker + VAPID).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique // URL push service browser (unik per perangkat+browser)
  p256dh    String   // kunci enkripsi publik langganan
  auth      String   // secret auth langganan
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}
