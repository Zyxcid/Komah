# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Mode database dipilih OTOMATIS oleh scripts/select-schema.mjs dari isi DATABASE_URL.

# ── Pilihan 1 (default): SQLite offline untuk development ──
# Tanpa internet, tanpa setup. Database file db/custom.db sudah termasuk data demo.
DATABASE_URL=file:../db/custom.db

# ── Pilihan 2: PostgreSQL/Neon untuk deploy produksi ──
# Ganti DATABASE_URL di atas dengan connection string Neon (pooled), lalu
# jalankan `npm run db:push` untuk membuat tabel di Neon:
# DATABASE_URL="postgresql://user:password@ep-xxxxxx-pooler.ap-southeast-1.aws.neon.tech/komah?sslmode=require"

# Web Push — notifikasi pesanan baru untuk driver (walau aplikasi ditutup).
# Generate pasangan kunci: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=GANTI_DENGAN_PUBLIC_KEY
VAPID_PRIVATE_KEY=GANTI_DENGAN_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@komah.id

# Notifikasi WhatsApp (opsional) — tanpa token, pesan hanya dicetak ke log server.
# FONNTE_TOKEN=

# Rahasia sesi login untuk produksi (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# AUTH_SECRET=
